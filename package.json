{
  "name": "@env-garden/cli",
  "version": "0.2.0",
  "description": "Command-line interface for Env Garden",
  "type": "module",
  "bin": {
    "eit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/tests/**/*.test.ts",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "env",
    "environment-variables",
    "secrets",
    "cli"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
